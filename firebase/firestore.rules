rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // MVP: clientId === owner's uid. Each oficina owner reads/writes
    // only their own user doc, their own client doc, and everything
    // nested under clients/{clientId} where clientId == their uid.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /clients/{clientId} {
      allow read, write: if request.auth != null && request.auth.uid == clientId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == clientId;
      }
    }
  }
}
